*.tgz

# Scratch space for local investigation; nothing here is a deliverable.
tmp/

# npm stores credentials in .npmrc. A USER-level one (~/.npmrc) is where a publish
# token belongs; a PROJECT-level one must never be committed by accident.
.npmrc

.DS_Store
*.log
coverage/

# Editor state, which belongs to the machine that produced it.
.vscode/

# Python bytecode from scripts/ helpers run during maintenance.
__pycache__/
